# Valores para rodar no host. No compose do vcnafacul-stack (tickets/055), os
# endereços (Redis, MinIO, callback do ms-simulado) são sobrescritos pelo
# próprio compose — não precisa editar nada aqui. Referência: app/config.py.

# App
OMR_PORT=8000
LOG_LEVEL=INFO
TEMPLATE_DIR=templates
# Teto de tentativas do arq (lido pelo worker E pelo pipeline)
OMR_MAX_TRIES=3

# Worker: roda dentro do processo da API (padrão). Com worker separado
# (`arq app.worker.WorkerSettings`), pôr false aqui para não ter dois consumidores.
OMR_INPROCESS_WORKER=true
# Leituras simultâneas. Default: nº de CPUs - 1. Em VPS pequena, 1.
# OMR_MAX_WORKERS=1

# S3 / MinIO (R2 em produção)
AWS_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
OMR_BUCKET=vcnafacul-cartoes

# Fila (arq) e cache das imagens
REDIS_URL=redis://localhost:6379/0
OMR_CACHE_TTL_SECONDS=3600

# Endpoint do ms-simulado que recebe o resultado da leitura
CALLBACK_URL=http://localhost:3000/v1/cartao-resposta/callback
