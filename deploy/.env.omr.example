# ===== ms-omr — env de HOMOLOGAÇÃO =====
# No servidor, copie este arquivo (preenchido) para: ~/env/.env.omr
# É consumido por: docker run --env-file ./env/.env.omr  (ver subir_ms_omr.sh)
# pydantic-settings, case-insensitive; nomes batem com app/config.py.

# --- Servidor (interno na rede docker; SEM porta publicada) ---
OMR_PORT=8000
LOG_LEVEL=INFO

# --- Worker in-process (Opção A) ---
# VM pequena → 1 worker (opencv é pesado). Não aumente sem upgradear a VM.
OMR_INPROCESS_WORKER=true
OMR_MAX_WORKERS=1

# --- Fila / cache (Redis na rede docker — ver subir_redis.sh) ---
REDIS_URL=redis://vcnafacul_redis:6379/0
OMR_CACHE_TTL_SECONDS=3600

# --- Callback pro ms-simulado (container na mesma rede network-vcnafacul) ---
# Rota confirmada no controller: @Controller('v1/cartao-resposta') + @Post('callback')
CALLBACK_URL=http://vcnafacul_simulado_prod:3000/v1/cartao-resposta/callback

# --- Bucket dos cartões no R2 (MESMAS credenciais R2 que o api já usa em ~/env/.env) ---
OMR_BUCKET=vcnafacul-cartoes
AWS_ENDPOINT=<copiar AWS_ENDPOINT do ~/env/.env do api>
AWS_REGION=<copiar AWS_REGION do api>
AWS_ACCESS_KEY_ID=<copiar AWS_ACCESS_KEY_ID do api>
AWS_SECRET_ACCESS_KEY=<copiar AWS_SECRET_ACCESS_KEY do api>
